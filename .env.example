# Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to git (it is in .gitignore)

# ============================================================================
# Google Gemini API Keys
# ============================================================================
# Required for LLM features (soft constraint reasoning, eligibility parsing)
#
# Strategy: Use multiple free-tier API keys to avoid rate limits
# The agent rotates through GOOGLE_API_KEY_1 through GOOGLE_API_KEY_10.
# Each free-tier project gets ~60 requests/minute quota.
#
# Get keys from: https://ai.google.dev/
# Free tier available for development (no billing required)
#
# OPTION A: Multiple keys (recommended for development)
# Provide 1-10 numbered keys. Agent rotates when quota exhausted.
GOOGLE_API_KEY_1=your_google_gemini_api_key_1_here
GOOGLE_API_KEY_2=your_google_gemini_api_key_2_here
GOOGLE_API_KEY_3=your_google_gemini_api_key_3_here
# ... add more keys as needed (up to GOOGLE_API_KEY_10)

# OPTION B: Single key fallback
# If no numbered keys provided, falls back to this one.
# Uncomment if using only one key instead of multiple:
# GOOGLE_API_KEY=your_google_gemini_api_key_here

# ============================================================================
# API Mode Selection
# ============================================================================
# Choose how to manage API quota and keys.
#
# Options:
#   DEVELOPMENT (default)
#     - Uses multiple free-tier API keys with automatic rotation
#     - Rotates to next key when quota exhausted (429 errors)
#     - Suitable for: Development, testing, rapid iteration
#     - Cost: Free (within free-tier limits)
#     - Requires: 1-10 numbered GOOGLE_API_KEY_1 through GOOGLE_API_KEY_10
#
#   PRODUCTION
#     - Uses single paid API key with quota-aware backoff
#     - Implements exponential backoff + circuit breaker pattern
#     - Suitable for: Production deployments with predictable costs
#     - Cost: Pay-as-you-go (Cloud Billing required)
#     - Requires: Single GOOGLE_API_KEY with paid quota
#
# Default: DEVELOPMENT (comment out or set to DEVELOPMENT for dev)
# Uncomment and set to PRODUCTION if using paid API quota:
# API_MODE=PRODUCTION
